<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      The service project has OutputType=Exe (Worker SDK), but the tray only
      consumes its IPC types. UndefineProperties strips the inherited RID and
      SelfContained from the P2P build, which avoids NETSDK1151 when publishing
      the tray framework-dependent (the service would otherwise default to
      SelfContained=true under -r and a non-self-contained tray cannot reference
      a self-contained exe).
    -->
    <ProjectReference Include="..\BlockRdpBruteForce\BlockRdpBruteForce.csproj">
      <UndefineProperties>RuntimeIdentifier;SelfContained;PublishSingleFile</UndefineProperties>
    </ProjectReference>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.7" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Twemoji 72x72 country flag PNGs. Each file is named by ISO 3166-1
      alpha-2 (e.g., us.png). LogicalName flattens the resource path so
      FlagImageProvider can look up by "Flags.us.png". CC-BY 4.0; see
      scripts/download-flags.ps1 for the source mirror.
    -->
    <EmbeddedResource Include="Resources\Flags\*.png">
      <LogicalName>BlockRdpBruteForce.Tray.Resources.Flags.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>